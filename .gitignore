# secrets and local data, never committed
.env
.env.*
*.pem
*.key
credentials.json
*.sqlite*
*.db
id_rsa*
# system and generated files
.DS_Store
__pycache__/
# the engine writes these type files for checking; every install gets its own
**/.claude-plugin/types/
# generated by the theme generators (previews, likeness, still frames, music masters)
themes/*/scene-*.svg
themes/*/*.wav
# Claude Code's local folders (settings.local.json, session notes, worktrees): personal, never published
.claude/
**/.claude/
settings.local.json
CLAUDE.local.md
